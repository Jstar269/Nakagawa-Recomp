// Modified for Nakagawa Recomp: pass 8 (Anime4K-v3.2-Upscale-CNN-x2-(M)-Depth-to-Space) of third_party/anime4k/Anime4K_Upscale_CNN_x2_M.glsl,
// wrapped as a Vulkan compute shader by tools/anime4k_port.py. The pass body below is
// upstream's, unchanged; only the wrapper around it is new. Do not edit: regenerate.

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D nk_tex0;  // MAIN
layout(set = 0, binding = 1) uniform sampler2D nk_tex1;  // conv2d_last_tf
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D nk_out;  // MAIN
layout(push_constant) uniform NkPass { ivec2 out_size; } nk_pc;
vec2 nk_pos;
#define MAIN_tex(p) texture(nk_tex0, (p))
#define MAIN_pos nk_pos
#define MAIN_size vec2(textureSize(nk_tex0, 0))
#define MAIN_pt (vec2(1.0) / MAIN_size)
#define MAIN_texOff(off) MAIN_tex(MAIN_pos + MAIN_pt * (off))
#define HOOKED_tex(p) texture(nk_tex0, (p))
#define HOOKED_pos nk_pos
#define HOOKED_size vec2(textureSize(nk_tex0, 0))
#define HOOKED_pt (vec2(1.0) / HOOKED_size)
#define HOOKED_texOff(off) HOOKED_tex(HOOKED_pos + HOOKED_pt * (off))
#define conv2d_last_tf_tex(p) texture(nk_tex1, (p))
#define conv2d_last_tf_pos nk_pos
#define conv2d_last_tf_size vec2(textureSize(nk_tex1, 0))
#define conv2d_last_tf_pt (vec2(1.0) / conv2d_last_tf_size)
#define conv2d_last_tf_texOff(off) conv2d_last_tf_tex(conv2d_last_tf_pos + conv2d_last_tf_pt * (off))
vec4 hook() {
    vec2 f0 = fract(conv2d_last_tf_pos * conv2d_last_tf_size);
    ivec2 i0 = ivec2(f0 * vec2(2.0));
    float c0 = conv2d_last_tf_tex((vec2(0.5) - f0) * conv2d_last_tf_pt + conv2d_last_tf_pos)[i0.y * 2 + i0.x];
    float c1 = c0;
    float c2 = c1;
    float c3 = c2;
    return vec4(c0, c1, c2, c3) + MAIN_tex(MAIN_pos);
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, nk_pc.out_size))) return;
    nk_pos = (vec2(p) + 0.5) / vec2(nk_pc.out_size);
    imageStore(nk_out, p, hook());
}
