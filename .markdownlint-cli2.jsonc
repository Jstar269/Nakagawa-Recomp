{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "build/**",
    // Vendored upstream code (tracked, such as third_party/clay) and local
    // upstream checkouts (gitignored): not ours to reformat.
    "third_party/**",
    // Private, gitignored run evidence (/logs/). Game-derived and scratch
    // material that must never be reformatted or treated as project source.
    "logs/**",
    ".claude/worktrees/**",
    "**/.gemini/**",
    "docs/archive/**",
    // The pull request template and the tool instruction files under .github/ keep their own
    // shape: two files by name and the .github/instructions/ folder. Everything else there is
    // linted like the root documents: the project documents (REVIEW.md, SUPPORT.md) and any
    // Markdown file added later, an issue template included (today's issue templates are YAML
    // forms).
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/copilot-instructions.md",
    ".github/instructions/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    // GitHub-rendered pages may centre a header and caption; nothing else needs raw HTML.
    "MD033": {
      "allowed_elements": ["div", "sub", "picture", "source", "img"]
    }
  }
}
